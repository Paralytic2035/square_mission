<launch>
  <!-- 默认读包内 config/square.yaml；现场可以覆盖：
       roslaunch square_mission square.launch param_file:=/abs/path/square_hardware.yaml -->
  <arg name="param_file" default="$(find square_mission)/config/square.yaml"/>

  <!-- 参数必须加载在全局命名空间（与课程 mission 包一致），
       放在 <node> 里会变成 /square_mission/altitude，节点读不到 -->
  <rosparam command="load" file="$(arg param_file)"/>

  <node pkg="square_mission" type="square_mission_node" name="square_mission" output="screen"/>
</launch>
